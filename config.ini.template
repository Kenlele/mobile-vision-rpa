# ================================================================================
#                   Mobile Vision RPA Configuration File (config.ini)
# ================================================================================
# 請複製此檔案為 config.ini 並填入您的 API Key。

[LLM]
# AI 服務提供者選項: gemini, openai, mock
provider = gemini

# 請在此貼上您的 API Key:
gemini_api_key = 
openai_api_key = 

# AI 模型名稱設定:
model_name = gemini-2.5-flash


[DRIVER]
# 驅動模式: ios, mock
driver_type = ios

# iOS 模擬器 UDID 設定: booted 或指定 UDID
udid = booted


[RPA]
# 每次任務允許的最大自動化步驟數
max_steps = 5

# 是否開啟除錯視覺截圖儲存
debug_mode = true
