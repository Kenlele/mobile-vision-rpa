# ================================================================================
#                   Mobile Vision RPA 設定檔 (config.ini)
# ================================================================================
# 請將此檔案複製為 config.ini 並貼上您的 Gemini API Key。

[LLM]
# 請在此貼上您的 Google Gemini API Key:
gemini_api_key = 

# AI 視覺模型設定 (預設推薦極速輕量的 gemini-2.5-flash，亦可填 gemini-1.5-pro):
model_name = gemini-2.5-flash


[DRIVER]
# 驅動模式: ios (Xcode iOS 模擬器), iphone_mirror (macOS 實體 iPhone 鏡像), mock (離線模擬)
driver_type = ios

# iOS 模擬器 UDID 設定: booted (自動選擇已開機模擬器) 或 指定 UDID
udid = booted


[RPA]
# 每次任務允許的最大步驟數
max_steps = 5

# 是否開啟除錯視覺截圖儲存 (輸出於 debug_output/ 目錄)
debug_mode = true
